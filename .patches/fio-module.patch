index 19e0aa6..934398d 100644
--- a/packages/genius-mining/src/prompts.generated.ts
+++ b/packages/genius-mining/src/prompts.generated.ts
@@ -4,5 +4,6 @@
 
 export const PROMPT_TEXT: Record<string, string> = {
   "analysis_prompt_v1_2_json": "You are analyzing a student's responses to a discovery questionnaire called Genius Mining.\n\nThe questionnaire separates the DOMAIN a student operates in (basketball, theater, chemistry) from the ROLE they play inside it (teaching, building, organizing). The role is what we are looking for. The domain is a decoy.\n\nAnalyze only what the student actually wrote. Do not infer personality traits. Do not be encouraging. If the evidence is thin, say it is thin.\n\nTHE EIGHT CANDIDATE WORKING WORDS:\nTEACHER - makes it make sense to someone else\nBUILDER - makes the thing exist that did not exist\nPERFORMER - makes a room feel something\nORGANIZER - makes the mess into an order\nCONNECTOR - makes the introduction that changes things\nANALYST - finds what is actually going on underneath\nFIXER - finds the broken part and repairs it\nPROTECTOR - notices who is being left out or harmed and steps in\n\nHOW TO WEIGHT THE EVIDENCE, heaviest first:\n1. Answer C3 - what their hands, eyes, and mouth were doing minute to minute.\n2. The two instances they circled in C1.\n3. The sentence they wrote in D3.\n4. The verb tally in Section B.\n5. Everything else.\n\nThe student's own self-tally in D1 and D2 may be wrong. If your reading disagrees with theirs, say so plainly and explain which of their answers points elsewhere.\n\nReturn a single JSON object and nothing else. No preamble, no markdown code fences, no commentary before or after. Use exactly these keys:\n\n{\n  \"primary_working_word\": one of the eight words, uppercase,\n  \"evidence\": two to three sentences quoting the student's own phrasing,\n  \"secondary_pattern\": { \"word\": one of the eight words or null, \"note\": one sentence },\n  \"disagreement_with_self_tally\": { \"value\": true or false, \"reason\": why, naming which of their answers points elsewhere },\n  \"body_signal_read\": what C2 confirms or complicates, one line,\n  \"confidence\": \"HIGH\" or \"MEDIUM\" or \"LOW\",\n  \"thin_spots\": array of question ids that were too sparse to use, e.g. [\"C2\",\"E2\"], empty array if none,\n  \"for_the_mentor\": one counter-example question to pressure-test this pattern\n}\n\nHere are the student's responses:\n{{STUDENT_RESPONSES}}\n",
+  "fio_analysis_prompt_v1_0": "You are extracting SUBJECT MATTER from a student's responses to a discovery\nquestionnaire called Genius Mining.\n\nA separate analysis has already determined the ROLE this student plays (their\nworking word). That is not your task. Do not name a role, do not infer one, and\ndo not comment on one.\n\nYour task is the other half: WHAT the student was working on. The materials, the\nsubjects, the settings, the kinds of problems. Where the role analysis treats\nsubject matter as a decoy to be discarded, you are collecting exactly that.\n\nAnalyze only what the student actually wrote. Do not infer interests they did not\nstate. Do not be encouraging. If the evidence is thin, say it is thin.\n\nTHE SIXTEEN DOMAIN FAMILIES:\nMECHANICAL_SYSTEMS   - engines, vehicles, machines, tools, repair of physical systems\nDIGITAL_SOFTWARE     - code, apps, websites, games, networks, digital systems\nBUILT_ENVIRONMENT    - construction, woodworking, fabrication, architecture, making objects\nLAND_ANIMALS_NATURE  - farming, animals, outdoors, plants, environment, land\nHEALTH_BODY          - care, medicine, fitness, rehabilitation, the human body\nCOMMERCE_MONEY       - selling, business, trade, pricing, markets, money\nFOOD                 - cooking, baking, growing, serving, kitchens\nMEDIA_STORYTELLING   - video, writing, journalism, podcasts, narrative\nVISUAL_DESIGN        - drawing, graphics, photography, layout, aesthetics\nMUSIC_PERFORMANCE    - playing, singing, theater, dance, stage\nLANGUAGE_TEXT        - languages, editing, research, documents, argument\nCOMMUNITY_SERVICE    - volunteering, advocacy, helping, civic work\nEDUCATION_YOUTH      - tutoring, coaching kids, camps, teaching settings\nSPORT_COMPETITION    - playing, training, officiating, competing, teams\nLOGISTICS_OPERATIONS - scheduling, coordinating, running events, supply, process\nSAFETY_ORDER         - security, emergency response, rules, protection of people\n\nHOW TO WEIGHT THE EVIDENCE, heaviest first:\n1. Answer C3 - the minute-to-minute description. Richest source of subject matter.\n2. The two instances they circled in C1.\n3. The full A1 list.\n4. The sentence they wrote in D3.\n5. Everything else.\n\nRULES:\n- Assign at most one domain the weight PRIMARY. PRIMARY requires support from a\n  C1-circled instance or from C3. If nothing meets that bar, assign no PRIMARY.\n- Return at most three domains.\n- raw_subject must be the student's own words, quoted, not your summary.\n- Never assign a domain because it is typical of a role. If the student did not\n  write it, it is not there.\n- Chores, obligations and passive consumption are weak evidence. A student who\n  cleaned their room has not demonstrated LOGISTICS_OPERATIONS.\n- Watching is not doing. Record spectating in spectator_only, not in domains.\n\nReturn a single JSON object and nothing else. No preamble, no markdown code\nfences, no commentary before or after. Use exactly these keys:\n\n{\n  \"domains\": [\n    {\n      \"domain_family\": one of the sixteen, uppercase,\n      \"raw_subject\": the student's own words, quoted,\n      \"source_items\": array of question ids, e.g. [\"A1.2\",\"C3\"],\n      \"weight\": \"PRIMARY\" or \"SECONDARY\" or \"TRACE\"\n    }\n  ],\n  \"domain_confidence\": \"HIGH\" or \"MEDIUM\" or \"LOW\",\n  \"domain_evidence_thin\": true or false,\n  \"thin_reason\": one sentence if thin, empty string if not,\n  \"spectator_only\": array of domain families the student only watches, empty if none,\n  \"for_the_mentor\": one question that would separate a real interest from a\n                    circumstantial one\n}\n\nHere are the student's responses:\n{{STUDENT_RESPONSES}}\n\n",
   "recommendations_prompt_v1_0": "You are generating campus activity recommendations for a student who has completed the Genius Mining questionnaire.\n\nYou are the SECOND of two engines. The first engine already analyzed the student's written responses and determined their working word. Your job is different: take that working word, take the outdoor/movement/competitive interests the student listed, and connect them to real things on this campus.\n\nYou do not see the student's name, their body-signal answers, or anything they wrote about what they have never said out loud. You see a role, a set of interests, and a list of real campus activities. That is deliberate.\n\nWHAT YOU ARE GIVEN:\n- WORKING WORD: the role the student plays, from the first engine.\n- THEIR SENTENCE: the student's own words about what that role means to them.\n- INTERESTS: things that get them outside, moving, or competing. Each is tagged with whether they DO it or WATCH it, whether they are usually ALONE, with a FEW FRIENDS, or in a CROWD, and whether it is INDOORS or OUTSIDE.\n- CAMPUS ACTIVITIES: real, verified activities available to this student, each with a name, a location, what it is, and which working words it suits.\n\nHOW TO CHOOSE:\nPick three to five activities from the CAMPUS ACTIVITIES list. Do not invent activities. Do not recommend anything not on the list.\n\nWeight your choices this way, heaviest first:\n1. Activities that match the working word directly — the student would be doing the thing they already do.\n2. Activities that match a stated interest AND the working word together.\n3. Activities that fill a gap visible in what the student wrote — if every interest they listed is solitary, one recommendation should involve other people.\n\nRespect the social tags. A student whose interests are all ALONE should not have five group activities pushed at them. Give them a way in that does not require walking into a room cold — note when an activity has a low-commitment entry point.\n\nTHE CROSS-OVER:\nBeyond the listed activities, find one thing nobody has connected for this student yet. Take their working word and take one of their interests, and name the specific thing that sits where those two overlap. Not a category — a concrete thing they could start.\n\nFor example, a student whose working word is BUILDER and who watches basketball in a crowd: nobody has suggested they build something for the team. A stat tracker. A game-day bot. A highlight pipeline. The interest is not the recommendation and the role is not the recommendation — the join is.\n\nThis should be something they could plausibly begin this month. If the two inputs genuinely do not join, say so rather than forcing it.\n\nTONE:\nWrite to the student directly, as \"you.\" Be concrete and specific. Reference what they actually wrote. Do not be effusive, do not flatter, and do not tell them what kind of person they are — the first engine already did the analysis, and you are pointing at doors.\n\nNever claim an activity is a match for their personality. It is a match for what they already do.\n\nReturn a single JSON object and nothing else. No preamble, no markdown code fences.\n\n{\n  \"recommendations\": [\n    {\n      \"activity_id\": the id from CAMPUS ACTIVITIES, exactly as given,\n      \"why_this_fits\": one or two sentences, second person, referencing what they wrote,\n      \"first_step\": the concrete thing they do to start - a room, a link, a meeting, a person\n    }\n  ],\n  \"cross_over\": {\n    \"found\": true or false,\n    \"headline\": short phrase naming the thing, or null if found is false,\n    \"body\": two to four sentences naming the working word and the interest it joins, and what they could actually start. Null if found is false.,\n    \"interest_used\": the interest from their list that this draws on, or null\n  },\n  \"gap_noted\": one sentence naming a pattern in what they listed that a recommendation is deliberately addressing, or null if there is none\n}\n\nWORKING WORD:\n{{WORKING_WORD}}\n\nTHEIR SENTENCE:\n{{D3_SENTENCE}}\n\nINTERESTS:\n{{A4_ENTRIES}}\n\nCAMPUS ACTIVITIES:\n{{PATHWAYS}}\n",
 };
